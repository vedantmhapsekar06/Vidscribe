# How summaries are generated:
#   local   -> runs facebook/bart-large-cnn on your own machine (free, no token; first run downloads ~1.6 GB)
#   hf_api  -> Hugging Face Inference API (needs HF_API_TOKEN and Inference Providers credits)
SUMMARIZER_BACKEND=local

# Only needed when SUMMARIZER_BACKEND=hf_api
HF_API_TOKEN=your_huggingface_token_here
